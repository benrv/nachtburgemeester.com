---
import '../styles/nightmayor.css';
---
<figure class="nightmayor nightmayor--live" data-tilt role="img" aria-label="Live hologram van een nachtburgemeester: een hoofd met een halvemaan als mond, een ambtsketen en een sjerp, opgebouwd uit bewegende lichtpunten.">
  <canvas id="nightMayorCanvas" class="nightmayor__canvas" aria-hidden="true"></canvas>
  <div class="nightmayor__scan" aria-hidden="true"></div>
  <div class="nightmayor__grain" aria-hidden="true"></div>
  <span class="nightmayor__corner nightmayor__corner--tl" aria-hidden="true"></span>
  <span class="nightmayor__corner nightmayor__corner--tr" aria-hidden="true"></span>
  <span class="nightmayor__corner nightmayor__corner--bl" aria-hidden="true"></span>
  <span class="nightmayor__corner nightmayor__corner--br" aria-hidden="true"></span>
</figure>
<script>
  (() => {
    const canvas = document.querySelector('#nightMayorCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const figure = canvas.closest('.nightmayor');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 680px)').matches;

    const TAU = Math.PI * 2;
    const rand = (a = 0, b = 1) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const ease = (t) => 1 - Math.pow(1 - t, 3);

    let W = 480, H = 600, DPR = 1, scale = .95, cx = 240, cy = 300;
    let points = [], lines = [], features = [], stars = [], pulses = [];
    let raf = 0, startTime = performance.now(), last = 0, visible = true;
    let px = 0, py = 0, tx = 0, ty = 0;
    let glitchUntil = 0, glitchBand = 0;

    const palette = {
      face: [241, 237, 227],
      acid: [216, 255, 62],
      flare: [255, 77, 30],
      halo: [241, 237, 227],
      ink: [10, 10, 11]
    };

    const add = (x, y, z, color, size, alpha, group) => {
      points.push({ x, y, z, color, size, alpha, group, delay: rand(0, .32), phase: rand(0, TAU) });
    };
    const line = (pts, color, alpha, width = 1) => lines.push({ pts, color, alpha, width });
    const feature = (kind, pts, color, alpha, width = 1, glow = 14) => features.push({ kind, pts, color, alpha, width, glow });

    const head = [
      [0, -208], [78, -198], [136, -154], [166, -82], [174, -8], [166, 60],
      [144, 114], [110, 154], [60, 178], [0, 184], [-60, 178], [-110, 154],
      [-144, 114], [-166, 60], [-174, -8], [-166, -82], [-136, -154], [-78, -198]
    ];
    const body = [
      [-246, 310], [-238, 246], [-190, 206], [-126, 182], [-58, 168], [-58, 212],
      [58, 212], [58, 168], [126, 182], [190, 206], [238, 246], [246, 310]
    ];
    const neck = [[-56, 150], [56, 150], [66, 218], [-66, 218]];

    const inside = (poly, x, y) => {
      let hit = false;
      for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        const xi = poly[i][0], yi = poly[i][1], xj = poly[j][0], yj = poly[j][1];
        if (((yi > y) !== (yj > y)) && (x < ((xj - xi) * (y - yi)) / (yj - yi) + xi)) hit = !hit;
      }
      return hit;
    };
    const bounds = (poly) => {
      let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
      for (const [x, y] of poly) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); }
      return { x0, x1, y0, y1 };
    };
    const fillPoly = (poly, n, color, size, alpha, z) => {
      const b = bounds(poly);
      let made = 0, guard = 0;
      while (made < n && guard++ < n * 8) {
        const x = rand(b.x0, b.x1), y = rand(b.y0, b.y1);
        if (!inside(poly, x, y)) continue;
        add(x, y, z + rand(-8, 8), color, size, alpha * rand(.5, 1), 'fill');
        made++;
      }
    };
    const smoothClosed = (poly, samples = 180) => {
      const out = [];
      const n = poly.length;
      for (let i = 0; i < n; i++) {
        const p0 = poly[(i - 1 + n) % n], p1 = poly[i], p2 = poly[(i + 1) % n], p3 = poly[(i + 2) % n];
        const steps = Math.max(4, Math.round(samples / n));
        for (let s = 0; s < steps; s++) {
          const t = s / steps, u = 1 - t;
          const x = .5 * ((2 * p1[0]) + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t * t + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t * t * t);
          const y = .5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t * t + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t * t * t);
          out.push({ x, y });
        }
      }
      return out;
    };
    const outlinePoly = (poly, color, alpha, width, z = 0, smooth = false) => {
      const pts = [];
      if (smooth) {
        for (const p of smoothClosed(poly, 220)) {
          pts.push({ x: p.x, y: p.y, z });
          add(p.x, p.y, z, color, 1.15, alpha * .8, 'edge');
        }
      } else {
        for (let i = 0; i < poly.length; i++) {
          const a = poly[i], b = poly[(i + 1) % poly.length];
          const steps = Math.max(8, Math.round(Math.hypot(b[0] - a[0], b[1] - a[1]) / 7));
          for (let s = 0; s < steps; s++) {
            const t = s / steps;
            const p = { x: a[0] + (b[0] - a[0]) * t, y: a[1] + (b[1] - a[1]) * t, z };
            pts.push(p);
            if (s % 2 === 0) add(p.x, p.y, p.z, color, 1.15, alpha * .8, 'edge');
          }
        }
      }
      line(pts, color, alpha, width);
    };
    const quad = (a, c, b, n = 20) => {
      const out = [];
      for (let i = 0; i <= n; i++) {
        const t = i / n, u = 1 - t;
        out.push({ x: u * u * a[0] + 2 * u * t * c[0] + t * t * b[0], y: u * u * a[1] + 2 * u * t * c[1] + t * t * b[1], z: 24 });
      }
      return out;
    };

    function eye(cx0, signed) {
      const inner = cx0 + signed * 27, outer = cx0 - signed * 27;
      const top = quad([outer, -58], [cx0, -78], [inner, -58], 18);
      const bottom = quad([inner, -58], [cx0, -42], [outer, -58], 18);
      feature('fill', [...top, ...bottom.reverse()], 'face', .94, 1, 18);
      feature('fill', [{ x: cx0, y: -60, z: 25, r: 6.5 }], 'ink', .95, 1, 0);
      feature('fill', [{ x: cx0 + 2, y: -63, z: 26, r: 2.2 }], 'acid', 1, 1, 0);
    }

    function build() {
      points = []; lines = []; features = []; stars = [];
      // body
      fillPoly(body, mobile ? 900 : 1700, 'face', 1.15, .34, -26);
      outlinePoly(body, 'face', .7, 1.5, -24, true);
      fillPoly(neck, mobile ? 90 : 160, 'face', .9, .2, -4);
      outlinePoly(neck, 'face', .22, .8, -2);
      // head
      fillPoly(head, mobile ? 560 : 1100, 'acid', .8, .17, 0);
      outlinePoly(head, 'acid', .78, 1.6, 4, true);
      // ears
      for (const side of [-1, 1]) {
        const ear = [];
        for (let i = 0; i < 16; i++) {
          const a = (TAU * i) / 16;
          ear.push({ x: side * 174 + Math.cos(a) * 10, y: -14 + Math.sin(a) * 20, z: 2 });
        }
        line(ear, 'acid', .32, .9);
      }
      // brows
      feature('stroke', quad([-108, -94], [-66, -116], [-28, -96], 16), 'face', .9, 3.4, 10);
      feature('stroke', quad([28, -96], [66, -116], [108, -94], 16), 'face', .9, 3.4, 10);
      eye(-66, 1);
      eye(66, -1);
      // nose
      feature('stroke', [
        { x: 0, y: -44, z: 26 }, { x: 0, y: 2, z: 28 }, { x: -12, y: 10, z: 28 }, { x: -3, y: 13, z: 28 }
      ], 'face', .72, 2.6, 10);
      // crescent mouth: bottom arc deep, upper arc shallower
      const mouthTop = quad([-58, 50], [0, 62], [58, 50], 22);
      const mouthBottom = quad([58, 50], [0, 104], [-58, 50], 22);
      feature('fill', [...mouthTop, ...mouthBottom], 'acid', .96, 1, 22);
      feature('stroke', mouthBottom, 'acid', .9, 2, 20);

      // shirt + lapels
      const shirt = [{ x: -45, y: 162, z: 22 }, { x: 0, y: 224, z: 24 }, { x: 45, y: 162, z: 22 }];
      line(shirt, 'face', .62, 1.6);
      const collarL = [{ x: -58, y: 164, z: 22 }, { x: -88, y: 198, z: 22 }, { x: -36, y: 210, z: 24 }];
      const collarR = [{ x: 58, y: 164, z: 22 }, { x: 88, y: 198, z: 22 }, { x: 36, y: 210, z: 24 }];
      line(collarL, 'face', .55, 1.3);
      line(collarR, 'face', .55, 1.3);
      const lapelL = [{ x: -52, y: 170, z: 20 }, { x: -122, y: 248, z: 18 }, { x: -48, y: 260, z: 20 }];
      const lapelR = [{ x: 52, y: 170, z: 20 }, { x: 122, y: 248, z: 18 }, { x: 48, y: 260, z: 20 }];
      line(lapelL, 'face', .5, 1.2);
      line(lapelR, 'face', .5, 1.2);

      // sash
      const sash = [];
      for (let i = 0; i <= 28; i++) {
        const t = i / 28;
        const x = -88 + 126 * t;
        const y = 184 + 126 * t;
        sash.push({ x, y, z: 20 });
        add(x, y, 20, 'flare', 1.6, .75, 'sash');
      }
      line(sash, 'flare', .95, 5.2);

      // chain links across chest
      const chain = [];
      for (let i = 0; i <= 30; i++) {
        const t = i / 30;
        const x = -88 + 176 * t;
        const y = 226 + Math.sin(t * Math.PI) * 18;
        chain.push({ x, y, z: 30 });
        if (i % 2 === 0) add(x, y, 30, 'acid', 2.8, 1, 'chain');
      }
      line(chain, 'acid', 1, 2.6);
      // four-point medallion
      const star = [[0, -1], [.2, -.2], [1, 0], [.2, .2], [0, 1], [-.2, .2], [-1, 0], [-.2, -.2]];
      for (let i = 0; i < star.length; i++) {
        const a = star[i], b = star[(i + 1) % star.length];
        const seg = [];
        for (let j = 0; j < 6; j++) {
          const t = j / 5;
          const p = { x: (a[0] + (b[0] - a[0]) * t) * 24, y: 272 + (a[1] + (b[1] - a[1]) * t) * 24, z: 32 };
          seg.push(p);
          add(p.x, p.y, p.z, 'acid', 2.2, .95, 'medal');
        }
        line(seg, 'acid', .9, 1.7);
      }
      for (let i = 0; i < 18; i++) {
        const a = (TAU * i) / 18;
        add(Math.cos(a) * 30, 272 + Math.sin(a) * 30, 32, 'acid', 1.5, .5, 'medal');
      }

      // halo
      for (const r of [224, 254]) {
        const ring = [];
        for (let i = 0; i < 56; i++) {
          const a = (TAU * i) / 56;
          const p = { x: Math.cos(a) * r, y: -12 + Math.sin(a) * r * .82, z: -45 };
          ring.push(p);
          if (i % 2 === 0) add(p.x, p.y, p.z, 'halo', .85, .16, 'halo');
        }
        line(ring, 'halo', .12, .7);
      }

      // skyline in the back
      for (let i = 0; i < (mobile ? 42 : 74); i++) {
        const x = rand(-240, 240);
        const y = rand(250, 306);
        add(x, y, -60, 'halo', .7, .08, 'city');
      }

      // stars
      stars = Array.from({ length: mobile ? 28 : 54 }, () => ({
        x: rand(0, W), y: rand(0, H), s: rand(.4, 1.4), a: rand(.08, .3), ph: rand(0, TAU)
      }));
    }

    function resize() {
      const r = canvas.getBoundingClientRect();
      W = Math.max(1, r.width); H = Math.max(1, r.height);
      DPR = Math.min(window.devicePixelRatio || 1, 1.8);
      canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      scale = Math.min(W / 500, H / 620) * .98;
      cx = W * .5; cy = H * .51;
      build();
    }

    const project = (x, y, z, cosY, sinY) => {
      const x1 = x * cosY - z * sinY;
      const z1 = x * sinY + z * cosY;
      const persp = 1 / (1 + z1 * .0012);
      return { x: cx + x1 * scale * persp, y: cy + y * scale * persp, z: z1 };
    };

    function drawFeature(f, assemble, cosY, sinY, now) {
      if (assemble < .35) return;
      const alpha = f.alpha * clamp((assemble - .35) / .65, 0, 1);
      if (f.kind === 'fill' && f.pts[0]?.r) {
        const ink = f.color === 'ink';
        if (ink) ctx.globalCompositeOperation = 'source-over';
        const p = f.pts[0];
        const q = project(p.x, p.y, p.z, cosY, sinY);
        const [r, g, b] = palette[f.color] || palette.face;
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.beginPath(); ctx.arc(q.x, q.y, p.r * scale, 0, TAU); ctx.fill();
        if (ink) ctx.globalCompositeOperation = 'lighter';
        return;
      }
      const q = f.pts.map((p) => project(p.x, p.y, p.z || 0, cosY, sinY));
      if (!q.length) return;
      ctx.beginPath();
      q.forEach((p, i) => i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y));
      if (f.kind === 'fill') {
        ctx.closePath();
        const [r, g, b] = palette[f.color] || palette.face;
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.shadowColor = `rgba(${r},${g},${b},.65)`;
        ctx.shadowBlur = f.glow;
        ctx.fill();
        ctx.shadowBlur = 0;
      } else {
        const [r, g, b] = palette[f.color] || palette.face;
        ctx.strokeStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.lineWidth = f.width;
        ctx.lineCap = 'round';
        ctx.shadowColor = `rgba(${r},${g},${b},.5)`;
        ctx.shadowBlur = f.glow;
        ctx.stroke();
        ctx.shadowBlur = 0;
      }
    }

    function draw(now) {
      if (!reduce) raf = requestAnimationFrame(draw);
      if (!visible || document.hidden) return;
      if (now - last < 32) return;
      last = now;
      const elapsed = now - startTime;
      const assemble = reduce ? 1 : clamp(elapsed / 2500, 0, 1);
      px += (tx - px) * .06; py += (ty - py) * .06;
      const t = now * .001;
      if (now > glitchUntil && Math.random() < .003) {
        glitchUntil = now + 130;
        glitchBand = rand(.25, .75);
      }

      ctx.clearRect(0, 0, W, H);
      const bg = ctx.createRadialGradient(cx + 20, cy - 80, 10, cx, cy, Math.max(W, H) * .72);
      bg.addColorStop(0, 'rgba(255,77,30,.16)');
      bg.addColorStop(.45, 'rgba(216,255,62,.035)');
      bg.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

      ctx.globalCompositeOperation = 'source-over';
      for (const s of stars) {
        const a = s.a * (.5 + .5 * Math.sin(t * .9 + s.ph));
        ctx.fillStyle = `rgba(241,237,227,${a * assemble})`;
        ctx.fillRect(s.x, s.y, s.s, s.s);
      }

      const rotY = .06 + px * .12 + Math.sin(t * .16) * .02;
      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
      const scan = reduce ? -10 : (t * .1) % 1.3 - .15;
      const glitching = !reduce && now < glitchUntil;

      // lines
      ctx.globalCompositeOperation = 'lighter';
      for (const l of lines) {
        const a = l.alpha * assemble;
        if (a < .01) continue;
        const [r, g, b] = palette[l.color] || palette.face;
        ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
        ctx.lineWidth = l.width;
        ctx.beginPath();
        l.pts.forEach((p, i) => {
          const q = project(p.x, p.y, p.z || 0, cosY, sinY);
          if (i === 0) ctx.moveTo(q.x, q.y); else ctx.lineTo(q.x, q.y);
        });
        ctx.stroke();
      }

      // particles
      for (const p of points) {
        const local = reduce ? 1 : ease(clamp(assemble * 1.35 - p.delay, 0, 1));
        if (local <= 0) continue;
        const startR = 1.8;
        const sx0 = p.x + Math.cos(p.phase) * startR * (1 - local);
        const sy0 = p.y + Math.sin(p.phase) * startR * (1 - local);
        const sz0 = p.z + Math.sin(p.phase) * 40 * (1 - local);
        let x = sx0 + Math.sin(t * .5 + p.phase) * .9;
        let y = sy0 + Math.cos(t * .4 + p.phase) * .7;
        if (glitching && p.group !== 'halo' && p.group !== 'city' && y > glitchBand * 400 - 40 && y < glitchBand * 400 + 40) x += 8;
        const q = project(x, y, sz0, cosY, sinY);
        if (q.x < -40 || q.x > W + 40 || q.y < -40 || q.y > H + 40) continue;
        const depth = clamp(.5 - q.z * .003, .2, 1);
        let a = p.alpha * local * depth;
        const scanHit = Math.abs(y + 12 - scan * 400) < 16;
        if (scanHit) a = Math.min(1, a + .35);
        for (const pulse of pulses) {
          const age = (now - pulse.t) / 750;
          if (age > 1) continue;
          const d = Math.hypot(q.x - pulse.x, q.y - pulse.y);
          if (Math.abs(d - age * 190) < 22) a = Math.min(1, a + (1 - age) * .7);
        }
        const [r, g, b] = palette[p.color] || palette.face;
        const size = Math.max(.6, p.size * (scanHit ? 1.7 : 1) * local);
        ctx.fillStyle = `rgba(${r},${g},${b},${a})`;
        if (p.group === 'chain' || p.group === 'medal' || p.group === 'sash') {
          ctx.shadowColor = `rgba(${r},${g},${b},.6)`;
          ctx.shadowBlur = 8;
        }
        ctx.fillRect(q.x - size / 2, q.y - size / 2, size, size);
        ctx.shadowBlur = 0;
      }

      // features (solid light shapes)
      for (const f of features) drawFeature(f, assemble, cosY, sinY, now);

      // orbit beacons
      for (let k = 0; k < 2; k++) {
        const a = reduce ? k * Math.PI : t * (.25 + k * .09) + k * Math.PI;
        const q = project(Math.cos(a) * 240, -12 + Math.sin(a) * 195, -45, cosY, sinY);
        ctx.fillStyle = k ? 'rgba(255,77,30,.85)' : 'rgba(216,255,62,.9)';
        ctx.beginPath(); ctx.arc(q.x, q.y, k ? 1.8 : 2.4, 0, TAU); ctx.fill();
      }

      // scan line
      const scanY = cy + 12 * scale - scan * 400 * scale;
      if (scanY > 0 && scanY < H) {
        const grad = ctx.createLinearGradient(0, scanY - 2, 0, scanY + 2);
        grad.addColorStop(0, 'rgba(216,255,62,0)');
        grad.addColorStop(.5, 'rgba(216,255,62,.13)');
        grad.addColorStop(1, 'rgba(216,255,62,0)');
        ctx.fillStyle = grad; ctx.fillRect(0, scanY - 2, W, 4);
      }
      if (glitching) {
        ctx.globalCompositeOperation = 'source-over';
        ctx.fillStyle = 'rgba(255,77,30,.035)';
        ctx.fillRect(0, H * glitchBand, W, H * .04);
      }
      ctx.globalCompositeOperation = 'source-over';
      ctx.shadowBlur = 0;
      pulses = pulses.filter((p) => now - p.t < 800);
    }

    figure.addEventListener('pointermove', (e) => {
      if (!window.matchMedia('(hover:hover)').matches) return;
      const r = figure.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - .5) * 2;
      ty = ((e.clientY - r.top) / r.height - .5) * 2;
    }, { passive: true });
    figure.addEventListener('pointerleave', () => { tx = 0; ty = 0; });
    figure.addEventListener('pointerdown', (e) => {
      const r = canvas.getBoundingClientRect();
      pulses.push({ t: performance.now(), x: e.clientX - r.left, y: e.clientY - r.top });
      glitchUntil = performance.now() + 180;
      glitchBand = .35 + Math.random() * .3;
    }, { passive: true });

    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(canvas);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { visible = entries[0]?.isIntersecting ?? true; }, { threshold: 0 }).observe(figure);
    }
    if (reduce) draw(performance.now());
    else raf = requestAnimationFrame(draw);
  })();
</script>
