---
import '../styles/skyline.css';

const windows = [];
const addWindows = (x, y, cols, rows, w, h, gx, gy, warm = false) => {
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if ((r * 7 + c * 3) % 5 === 0) continue;
      windows.push({
        x: x + c * (w + gx),
        y: y + r * (h + gy),
        w, h,
        cls: warm ? 'sky-win sky-win--warm' : 'sky-win',
        delay: -((r * 1.7 + c * .9) % 8)
      });
    }
  }
};
addWindows(292, 422, 7, 2, 9, 12, 13, 10);
addWindows(600, 386, 9, 4, 7, 11, 16, 13);
addWindows(906, 330, 2, 7, 8, 11, 12, 14, true);
addWindows(1104, 452, 9, 2, 10, 9, 12, 12);
addWindows(1344, 424, 5, 2, 12, 10, 18, 12, true);
addWindows(30, 445, 5, 2, 8, 9, 14, 10);

const bulbs = Array.from({ length: 14 }, (_, i) => ({ x: 268 + i * 21, y: 382, d: -(i * .12) }));
const signBulbs = Array.from({ length: 7 }, (_, i) => ({ x: 930, y: 196 + i * 25, d: -(i * .18) }));
---
<div class="hero-skyline" aria-hidden="true">
  <svg viewBox="0 0 1600 520" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="beamGrad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#D8FF3E" stop-opacity=".22"></stop>
        <stop offset="1" stop-color="#D8FF3E" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="beamWarm" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#FF4D1E" stop-opacity=".18"></stop>
        <stop offset="1" stop-color="#FF4D1E" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="skyFrontFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#191A1D"></stop>
        <stop offset="1" stop-color="#09090B"></stop>
      </linearGradient>
      <linearGradient id="skyBackFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#202127"></stop>
        <stop offset="1" stop-color="#121216"></stop>
      </linearGradient>
    </defs>

    <!-- verre culturele skyline -->
    <g class="skyline__back">
      <path d="M0 520V364h54v-42h42v42h28V300h64v-56h34v56h52v-80h42v80h58v-38h32v38h44v-62h54v62h32v-30h38v30h30v-92h54v92h32v-42h46v42h36v-64h50v64h32v-36h40v36h34v-78h50v78h32v-44h42v44h36v-58h58v58h32v-36h42v36h50v-70h46v70h30v-42h50v42h36v-54h42v54h40v-30h54v30h42v-60h44v60h42v-32h36v32h40v-72h54v72h26v156z"
        fill="url(#skyBackFill)"></path>
      <!-- kerk / erfgoed -->
      <path d="M735 520V274h44v-38h-8v-20h8v-28h8v28h8v20h-8v38h18v246z" fill="url(#skyBackFill)"></path>
      <path d="M735 274l22-48 22 48z" fill="url(#skyBackFill)"></path>
      <!-- theaterdome -->
      <path d="M1160 520V320h104v200z" fill="url(#skyBackFill)"></path>
      <path d="M1160 320c0-58 22-88 52-88s52 30 52 88z" fill="url(#skyBackFill)"></path>
      <path d="M1212 232v-24" stroke="#F1EDE3" stroke-opacity=".12" stroke-width="2"></path>
      <!-- fabrieksschoorstenen -->
      <rect x="470" y="300" width="8" height="120" fill="url(#skyBackFill)"></rect>
      <rect x="880" y="330" width="10" height="110" fill="url(#skyBackFill)"></rect>
      <rect x="885" y="295" width="10" height="40" fill="url(#skyBackFill)"></rect>
    </g>

    <!-- voorgrond: club, theater, concertzaal, cinema, museum -->
    <g class="skyline__front">
      <!-- club / warehouse -->
      <path d="M0 520V394h34v-26h30v26h22v-34h34v34h22v-22h32v22h22V368l42-34 42 34v152z" fill="url(#skyFrontFill)"></path>
      <path d="M0 394h54l30-26 30 26h22l34-34 34 34h22l32-22 32 22h22" fill="none" class="sky-rim"></path>
      <rect x="26" y="420" width="8" height="18" class="sky-win"></rect>
      <rect x="54" y="420" width="8" height="18" class="sky-win sky-win--warm"></rect>
      <rect x="82" y="420" width="8" height="18" class="sky-win"></rect>
      <rect x="180" y="430" width="90" height="4" class="sky-neon"></rect>

      <!-- theater / schouwburg -->
      <rect x="248" y="340" width="278" height="180" fill="url(#skyFrontFill)"></rect>
      <path d="M232 388h310v-24H232z" fill="url(#skyFrontFill)"></path>
      <path d="M220 364h334v-12H220z" class="sky-rim" fill="none"></path>
      <rect x="300" y="434" width="54" height="86" fill="#09090B"></rect>
      <rect x="420" y="434" width="54" height="86" fill="#09090B"></rect>
      <path d="M282 434h206" class="sky-neon-line"></path>
      <path d="M338 340v-34h96v34" fill="none" class="sky-rim"></path>
      <rect x="370" y="300" width="32" height="20" fill="#09090B"></rect>

      <!-- concertzaal -->
      <rect x="570" y="342" width="258" height="178" fill="url(#skyFrontFill)"></rect>
      <path d="M570 342l129-68 129 68z" fill="url(#skyFrontFill)"></path>
      <path d="M558 342h282" class="sky-rim"></path>
      <path d="M600 360v160M628 360v160M656 360v160M684 360v160M712 360v160M740 360v160M768 360v160M796 360v160" stroke="#0A0A0B" stroke-width="3" opacity=".8"></path>
      <path d="M570 418h258" class="sky-neon-line"></path>

      <!-- cinema / art deco tower -->
      <rect x="902" y="286" width="88" height="234" fill="url(#skyFrontFill)"></rect>
      <rect x="880" y="426" width="146" height="94" fill="url(#skyFrontFill)"></rect>
      <rect x="926" y="168" width="40" height="118" fill="url(#skyFrontFill)"></rect>
      <path d="M926 168h40v-16h-40z" fill="url(#skyFrontFill)"></path>
      <path d="M902 286h88" class="sky-rim"></path>
      <path d="M888 426h130" class="sky-rim"></path>
      <rect x="940" y="392" width="12" height="52" class="sky-neon"></rect>
      <path d="M902 452h88" class="sky-neon-line"></path>

      <!-- club / lage zaal -->
      <path d="M1058 520V428h34l22-32 42 32h28l24-24 32 24h20v72z" fill="url(#skyFrontFill)"></path>
      <path d="M1058 428h34l22-32 42 32h28l24-24 32 24h20" fill="none" class="sky-rim"></path>
      <rect x="1086" y="444" width="86" height="4" class="sky-neon"></rect>
      <rect x="1110" y="462" width="36" height="58" fill="#09090B"></rect>

      <!-- museum / moderne vleugel -->
      <path d="M1300 520V376h118v-42h122v186z" fill="url(#skyFrontFill)"></path>
      <path d="M1290 376h134v-42h128" class="sky-rim" fill="none"></path>
      <path d="M1340 398h60v50h-60zM1420 350h82v98h-82z" fill="#0A0A0B" opacity=".6"></path>
      <path d="M1320 468h110M1450 468h210" class="sky-neon-line"></path>

      <rect x="0" y="516" width="1600" height="4" fill="#050506"></rect>
    </g>

    <!-- ramen -->
    <g>
      {windows.map((w) => <rect x={w.x} y={w.y} width={w.w} height={w.h} class={w.cls} style={`--d:${w.delay}s`}></rect>)}
    </g>

    <!-- marquee-lampen -->
    <g>
      {bulbs.map((b) => <circle cx={b.x} cy={b.y} r="2.2" class="sky-bulb" style={`--d:${b.d}s`}></circle>)}
      {signBulbs.map((b) => <circle cx={b.x} cy={b.y} r="2.4" class="sky-bulb sky-bulb--warm" style={`--d:${b.d}s`}></circle>)}
    </g>

    <!-- zoeklichten -->
    <g class="sky-beams">
      <polygon points="700,330 594,-130 780,-130" fill="url(#beamGrad)" class="sky-beam sky-beam--a"></polygon>
      <polygon points="1200,300 1112,-120 1270,-120" fill="url(#beamWarm)" class="sky-beam sky-beam--b"></polygon>
    </g>
  </svg>
</div>
