---
import { cities } from '../lib/cities';
interface Props { endpoint?: string; }
const { endpoint = '' } = Astro.props;
---
<form class="correct__form" id="correctionForm" novalidate data-endpoint={endpoint} action="mailto:hallo@nachtburgermeester.com" method="post" enctype="text/plain">
  <h2>Correctie doorgeven</h2>
  <p class="intro">Vul in wat er niet klopt. Een bron helpt ons om het snel te controleren. Je hoeft geen account aan te maken.</p>

  <div class="field">
    <label for="corrCity">Stad</label>
    <select id="corrCity" name="city" required>
      <option value="">Kies een stad</option>
      {cities.map((c) => <option value={c.id}>{c.city}</option>)}
      <option value="andere-stad">Andere stad / niet in het register</option>
    </select>
  </div>

  <div class="field">
    <label for="corrText">Wat klopt er niet?</label>
    <textarea id="corrText" name="correction" rows="4" placeholder="Bijv. een nieuwe naam, verkeerde datum, ontbrekende bron…" required></textarea>
  </div>

  <div class="field">
    <label for="corrSource">Bron (URL of omschrijving)</label>
    <input id="corrSource" name="source" type="text" placeholder="https://… of: gemeente, 12 november 2026" required />
  </div>

  <div class="field field--half">
    <label for="corrMail">Je e-mail <span>(optioneel, voor een reactie)</span></label>
    <input id="corrMail" name="email" type="email" placeholder="jij@nacht.nl" autocomplete="email" />
  </div>

  <div class="hp" aria-hidden="true">
    <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="field--check">
    <input id="corrConsent" name="consent" type="checkbox" required />
    <label for="corrConsent">Ik ga ermee akkoord dat mijn melding en e-mailadres worden gebruikt om deze correctie te controleren. Zie de <a href="/privacy/">privacyverklaring</a>.</label>
  </div>

  <button class="btn btn--acid btn--lg" type="submit">Verstuur correctie <span aria-hidden="true">↗</span></button>
  <p class="form__msg" id="formMsg" role="status">We controleren elke melding. Je hoort van ons als we iets aanpassen.</p>
  <noscript><p class="form__msg">JavaScript staat uit. Mail je correctie naar <a href="mailto:hallo@nachtburgermeester.com">hallo@nachtburgermeester.com</a>.</p></noscript>
</form>
