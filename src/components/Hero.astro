---
import NightSkyline from './NightSkyline.astro';
const word = 'NACHTBURGEMEESTER';
const letters = [...word];
---
<section class="hero hero--word" aria-labelledby="heroTitle">
  <canvas class="hero__stars" id="heroStars" aria-hidden="true"></canvas>
  <div class="hero__rig" aria-hidden="true"><i></i><i></i></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--a" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b" aria-hidden="true"></div>
  <div class="hero__fog" aria-hidden="true"></div>
  <NightSkyline />

  <div class="wrap hero__wrap hero__wrap--word">
    <h1 class="hero__title hero__title--word" id="heroTitle" aria-label="Nachtburgemeester">
      <span class="hero__word" aria-hidden="true">
        {letters.map((letter, i) => <span class="letter" style={`--i:${i}`}>{letter}</span>)}
      </span>
    </h1>
  </div>
</section>
