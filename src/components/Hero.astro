---
import NightMayor from './NightMayor.astro';
---
<section class="hero hero--monument" aria-labelledby="heroTitle">
  <canvas class="hero__stars" id="heroStars" aria-hidden="true"></canvas>
  <div class="hero__rig" aria-hidden="true"><i></i><i></i></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--a" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b" aria-hidden="true"></div>
  <div class="hero__fog" aria-hidden="true"></div>

  <div class="wrap hero__wrap hero__wrap--monument">
    <div class="hero__main hero__main--monument">
      <h1 class="hero__title hero__title--monument" id="heroTitle" aria-label="Nachtburgemeester">
        <span class="line">
          <span class="word" data-text="NACHT" style="--i:0">NACHT</span>
        </span>
        <span class="line">
          <span class="word" data-text="BURGEMEESTER" style="--i:1">BURGEMEESTER</span>
        </span>
      </h1>
    </div>

    <aside class="hero__aside hero__aside--monument">
      <NightMayor />
    </aside>
  </div>
</section>
