---
import Base from '../layouts/Base.astro';
---
<Base title="Niet gevonden | Nachtregister" description="Deze pagina bestaat niet." noindex>
  <section class="page-hero">
    <div class="wrap">
      <p class="page-hero__kicker">404</p>
      <h1 class="display display--sm">Deze nacht<br /><em>bestaat niet.</em></h1>
      <p class="page-hero__lede">De pagina die je zoekt is verplaatst of nooit geboren. Ga terug naar het register of zoek een stad.</p>
      <p style="margin-top:30px"><a class="btn btn--acid" href="/">Naar het register <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>
</Base>
